{
  "compilerOptions": {
    "target": "ES2022" /* ⚡ ہارڈ ویئر رینڈرنگ کے لیے جدید ترین جاوا اسکرپٹ ماڈل */,
    "module": "NodeNext" /* 🧬 ماڈرن کلاؤڈ مڈل ویئر پائپ لائن سپورٹ */,
    "moduleResolution": "NodeNext" /* 🎯 الٹرا-فاسٹ نوڈ فائل پاتھ اسکیننگ */,
    "outDir": "./dist" /* 📦 فائنل کمپریسڈ پروڈکشن کوڈ کا کلین فولڈر */,
    "rootDir": "./src" /* 🏗️ ہمارا اصلی مینوفیکچرڈ سورس کوڈ فولڈر */,
    "strict": true /* 🔴 THE ATOMIC GUARD: کچرا ڈیٹا کا داخلہ ہوا میں فلی بلاک */,
    "noImplicitAny": true /* 🛡️ اندھے اور مبہم ویری ایبلز پر سخت قانونی پابندی */,
    "strictNullChecks": true /* ✕ رن ٹائم پر نل (Null) کریش عذاب کا مستقل خاتمہ */,
    "esModuleInterop": true /* 🔗 پرانے اور نئے ماڈیولز کا مکھن برقی ہینڈ شیک */,
    "skipLibCheck": true /* 🏎️ بیرونی پیکیجز کا فالتو آڈٹ بائی پاس کر کے بلڈ اسپیڈ بڑھانا */,
    "forceConsistentCasingInFileNames": true /* 📁 لینکس اور ونڈوز فائل سسٹم کے ناموں کا تضاد مٹانا */
  },
  "include": ["src/**/*"] /* 🎯 چوکیدار صرف ہمارے سورس کوڈ پر سخت پہرہ دے گا */
}
